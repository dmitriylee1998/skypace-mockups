# Send test emails from your Gmail.
# 1. Turn on 2-Step Verification: https://myaccount.google.com/signinoptions/two-step-verification
# 2. Create an App Password:      https://myaccount.google.com/apppasswords  (16 characters)
# 3. Copy this file to emails/.env, fill in the two lines below, restart: python3 emails/server.py
#    Never put the real password in this example file — only emails/.env is ignored by git and Railway.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
# Gmail sends from SMTP_USER; the display name is up to you
SMTP_FROM=Skypace Test <you@gmail.com>
# Optional: where emails/img is hosted. Set it and test emails link to images instead of embedding them
# (no images in the Attachments list in Outlook — the same as real sends).
# ASSET_URL=https://your-cdn.example.com/email/img
